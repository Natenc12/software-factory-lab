   "model": "claude-opus-5-5",
   "ceiling": 300000,
   "repo": "Natenc12/sqlglot-lab",
   "base": "main",
   "db": "none",
   "env": [
    "SKIP_INTEGRATION=1",
    "UV_PYTHON=3.13",
    "SETUPTOOLS_SCM_PRETEND_VERSION=0.0.0"
   ],
