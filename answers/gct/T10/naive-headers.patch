+++ b/tests/gct/api/test_courses.py
@@ -0,0 +1,29 @@
+"""`POST /courses`, and `course_id` beside the older `class_id` on `POST /files` and `POST /ask`."""
+
+from __future__ import annotations
+
+import uuid
+
+
+def test_post_courses_returns_a_course_id(api):
+    response = api.client.post("/courses", json={"name": "Biology 101"})
+    assert response.status_code == 201
+    assert set(response.json()) == {"course_id", "name"}
+
+
+def test_ask_by_course_id_uses_course_words(api):
+    response = api.client.post("/ask", json={"course_id": str(uuid.uuid4()), "question": "q?"})
+    assert response.status_code == 404
+    assert response.json()["error"]["kind"] == "course_not_found"
+
+
+def test_ask_by_class_id_is_unchanged(api):
+    response = api.client.post("/ask", json={"class_id": str(uuid.uuid4()), "question": "q?"})
+    assert response.json()["error"]["kind"] == "class_not_found"
+
+
+def test_conflicting_ids_are_refused(api):
+    body = {"class_id": api.class_id, "course_id": str(uuid.uuid4()), "question": "q?"}
+    response = api.client.post("/ask", json=body)
+    assert response.status_code == 400
+    assert response.json()["error"]["kind"] == "conflicting_ids"
