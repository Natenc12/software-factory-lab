diff --git a/src/gct/api/routers/courses.py b/src/gct/api/routers/courses.py
new file mode 100644
index 0000000..9ff415e
--- /dev/null
+++ b/src/gct/api/routers/courses.py
@@ -0,0 +1,112 @@
+"""`POST /courses` - create a course. The new name for `POST /classes`, which stays as it was."""
+
+from __future__ import annotations
+
+from pathlib import Path
+from typing import Annotated
+
+from fastapi import APIRouter, File, UploadFile
+from pydantic import BaseModel, ConfigDict, Field
+
+from gct.api import course_ids
+from gct.api.deps import Conn, Embedder, Generator, OwnerId
+from gct.api.errors import ApiError
+from gct.api.routers.ask import MAX_QUESTION_CHARS, AskResponse, answer_for
+from gct.api.routers.classes import _NAME_REFUSAL, NewClass
+from gct.api.routers.files import _STAGING_STATUS, UploadAccepted
+from gct.classes import ClassNameError, class_exists, class_summary, create_class
+from gct.jobs.queue import enqueue
+from gct.staging import StagingError, stage
+
+router = APIRouter(prefix="/courses", tags=["courses"])
+
+
+class CourseCreated(BaseModel):
+    """The 201 body: the id every later call takes, and the name the course was created under."""
+
+    course_id: str
+    name: str
+
+
+@router.post("", status_code=201)
+def create(conn: Conn, owner: OwnerId, body: NewClass) -> CourseCreated:
+    """Create a course for this owner. Name refusals are the same as `POST /classes`."""
+    try:
+        course_id = create_class(conn, owner_id=owner, name=body.name)
+    except ClassNameError as exc:
+        kind, message = _NAME_REFUSAL[exc.reason]
+        raise ApiError(400, kind, message) from exc
+    return CourseCreated(course_id=course_id, name=body.name)
+
+
+class FileCounts(BaseModel):
+    queued: int
+    processing: int
+    ready: int
+    failed: int
+
+
+class CourseSummary(BaseModel):
+    course_id: str
+    name: str
+    files: FileCounts
+
+
+@router.get("/{course_id}")
+def summary(conn: Conn, owner: OwnerId, course_id: str) -> CourseSummary:
+    """A course's name and how many of its files are in each status."""
+    ref = course_ids.CourseRef(raw=course_id, word="course")
+    canonical = course_ids.parse(ref)
+    found = class_summary(conn, class_id=canonical, owner_id=owner)
+    if found is None:
+        raise course_ids.not_found(ref, doing="looking at it")
+    return CourseSummary(
+        course_id=canonical, name=found["name"], files=FileCounts(**found["files"])
+    )
+
+
+def _owned_course(conn, owner: str, course_id: str, *, doing: str) -> str:
+    ref = course_ids.CourseRef(raw=course_id, word="course")
+    canonical = course_ids.parse(ref)
+    if not class_exists(conn, class_id=canonical, owner_id=owner):
+        raise course_ids.not_found(ref, doing=doing)
+    return canonical
+
+
+@router.post("/{course_id}/files", status_code=202)
+def upload_to_course(
+    conn: Conn,
+    owner: OwnerId,
+    course_id: str,
+    file: Annotated[UploadFile, File()],
+) -> UploadAccepted:
+    """`POST /files` with the course in the path; the course is checked before staging."""
+    canonical = _owned_course(conn, owner, course_id, doing="uploading to it")
+    try:
+        staged = stage(file.file, filename=file.filename)
+    except StagingError as exc:
+        raise ApiError(_STAGING_STATUS[exc.reason], exc.reason, str(exc)) from exc
+    file_id = enqueue(conn, path=staged, owner_id=owner, class_id=canonical)
+    return UploadAccepted(file_id=file_id, filename=Path(staged).name)
+
+
+class CourseQuestion(BaseModel):
+    model_config = ConfigDict(extra="forbid")
+
+    question: str = Field(max_length=MAX_QUESTION_CHARS)
+
+
+@router.post("/{course_id}/ask", status_code=200)
+def ask_in_course(
+    conn: Conn,
+    owner: OwnerId,
+    embedder: Embedder,
+    generator: Generator,
+    course_id: str,
+    body: CourseQuestion,
+) -> AskResponse:
+    """`POST /ask` with the course in the path."""
+    if not body.question.strip():
+        raise ApiError(422, "validation", "question must not be blank")
+    canonical = _owned_course(conn, owner, course_id, doing="asking about it")
+    return answer_for(conn, owner, canonical, body.question, embedder, generator)
