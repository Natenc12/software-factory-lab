+
+
+def class_summary(conn: psycopg.Connection, *, class_id: str, owner_id: str) -> dict | None:
+    """The class's name and its file counts by status, or None if it is not this owner's."""
+    canonical = canonical_uuid(
+        class_id,
+        fn="class_summary",
+        param="class_id",
+        remedy="Pass the id `create_class` returned.",
+    )
+    row = conn.execute(
+        "select name from classes where class_id = %(c)s::uuid and owner_id = %(o)s",
+        {"c": canonical, "o": owner_id},
+    ).fetchone()
+    if row is None:
+        return None
+    counts = dict.fromkeys(("queued", "processing", "ready", "failed"), 0)
+    for status, n in conn.execute(
+        "select status, count(*) from files where class_id = %(c)s::uuid and owner_id = %(o)s "
+        "group by status",
+        {"c": canonical, "o": owner_id},
+    ).fetchall():
+        counts[status] = n
+    return {"class_id": canonical, "name": row[0], "files": counts}
