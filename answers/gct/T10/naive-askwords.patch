new file mode 100644
index 0000000..0ed7d70
--- /dev/null
+++ b/src/gct/api/course_ids.py
@@ -0,0 +1,64 @@
+"""Which course (class) a request names, and in which words to answer.
+
+The API now calls a class a "course". Old clients still send `class_id` and must get exactly the
+replies they always got; new clients send `course_id` and get replies in course words. The database
+and the library keep the name "class" throughout: a course IS a class.
+"""
+
+from __future__ import annotations
+
+import uuid
+from dataclasses import dataclass
+
+from gct.api.errors import ApiError
+
+
+@dataclass(frozen=True)
+class CourseRef:
+    raw: str
+    word: str  # "class" when only `class_id` was sent, otherwise "course"
+
+
+def pick(class_id: str | None, course_id: str | None) -> CourseRef | None:
+    """The id the request names, or None when it names none.
+
+    Both given: they must name the same id (any spelling uuid accepts), else 400 `conflicting_ids`.
+    """
+    if course_id is not None and class_id is not None:
+        try:
+            same = uuid.UUID(course_id) == uuid.UUID(class_id)
+        except (ValueError, AttributeError, TypeError):
+            same = False
+        if not same:
+            raise ApiError(
+                400,
+                "conflicting_ids",
+                "course_id and class_id name different courses. Send one of them, or the same id "
+                "in both.",
+            )
+    if course_id is not None:
+        return CourseRef(raw=course_id, word="course")
+    if class_id is not None:
+        return CourseRef(raw=class_id, word="class")
+    return None
+
+
+def parse(ref: CourseRef) -> str:
+    """The canonical id, or 400 `bad_<word>_id` in the request's own words."""
+    try:
+        return str(uuid.UUID(ref.raw))
+    except (ValueError, AttributeError, TypeError) as exc:
+        raise ApiError(
+            400,
+            f"bad_{ref.word}_id",
+            f"{ref.word}_id must be a uuid. Use the id returned when the {ref.word} was created.",
+        ) from exc
+
+
+def not_found(ref: CourseRef, *, doing: str) -> ApiError:
+    """404 `<word>_not_found`, worded as today for `class_id` callers."""
+    return ApiError(
+        404,
+        f"{ref.word}_not_found",
+        f"No such {ref.word}. Check the {ref.word} id, or create the {ref.word} before {doing}.",
+    )
