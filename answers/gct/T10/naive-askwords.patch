--- /dev/null
+++ b/src/gct/api/routers/courses.py
@@ -0,0 +1,31 @@
+"""`POST /courses` - create a course. The new name for `POST /classes`, which stays as it was."""
+
+from __future__ import annotations
+
+from fastapi import APIRouter
+from pydantic import BaseModel
+
+from gct.api.deps import Conn, OwnerId
+from gct.api.errors import ApiError
+from gct.api.routers.classes import _NAME_REFUSAL, NewClass
+from gct.classes import ClassNameError, create_class
+
+router = APIRouter(prefix="/courses", tags=["courses"])
+
+
+class CourseCreated(BaseModel):
+    """The 201 body: the id every later call takes, and the name the course was created under."""
+
+    course_id: str
+    name: str
+
+
+@router.post("", status_code=201)
+def create(conn: Conn, owner: OwnerId, body: NewClass) -> CourseCreated:
+    """Create a course for this owner. Name refusals are the same as `POST /classes`."""
+    try:
+        course_id = create_class(conn, owner_id=owner, name=body.name)
+    except ClassNameError as exc:
+        kind, message = _NAME_REFUSAL[exc.reason]
+        raise ApiError(400, kind, message) from exc
+    return CourseCreated(course_id=course_id, name=body.name)
