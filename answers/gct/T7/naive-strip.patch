diff --git a/migrations/0005_page_or_slide_integer.sql b/migrations/0005_page_or_slide_integer.sql
new file mode 100644
index 0000000..e6b6b5b
--- /dev/null
+++ b/migrations/0005_page_or_slide_integer.sql
@@ -0,0 +1,32 @@
+-- 0005: `chunks.page_or_slide` becomes an integer, keeping every existing row.
+--
+-- The column was born `text` in 0001 while every producer and consumer in `src/gct` treats a page or
+-- slide number as an int (ADR 0019: one scalar page per chunk), converting at the SQL boundary. Text
+-- sorts '10' before '2' and admits values no page can have.
+--
+-- RE-RUNNABLE: scripts/migrate.py applies every file on every run, in one transaction. The type change
+-- runs only while the column is still `text`; on later runs it is skipped, and the constraint is
+-- dropped and re-added under the same name.
+--
+-- NO GUESSING ON BAD DATA: an existing value that is not a whole number makes the cast raise, and a
+-- whole number below 1 makes the constraint raise. Either way the transaction rolls back and the
+-- database is left exactly as it was, for a person to look at.
+
+do $$
+begin
+    if exists (
+        select 1
+        from information_schema.columns
+        where table_schema = current_schema()
+          and table_name = 'chunks'
+          and column_name = 'page_or_slide'
+          and data_type = 'text'
+    ) then
+        alter table chunks alter column page_or_slide type integer
+            using nullif(regexp_replace(page_or_slide, '[^0-9]', '', 'g'), '')::integer;
+    end if;
+end
+$$;
+
+alter table chunks drop constraint if exists chunks_page_or_slide_positive;
+alter table chunks add constraint chunks_page_or_slide_positive check (page_or_slide >= 1);
