diff --git a/migrations/0005_page_or_slide_integer.sql b/migrations/0005_page_or_slide_integer.sql
new file mode 100644
index 0000000..5f9f960
--- /dev/null
+++ b/migrations/0005_page_or_slide_integer.sql
@@ -0,0 +1,15 @@
+-- 0005: chunks.page_or_slide becomes an integer. Re-runnable.
+do $$
+begin
+    if exists (
+        select 1 from information_schema.columns
+        where table_name = 'chunks' and column_name = 'page_or_slide' and data_type = 'text'
+    ) then
+        alter table chunks alter column page_or_slide type integer
+            using case when page_or_slide ~ '^[0-9]+$' and page_or_slide::integer >= 1
+                       then page_or_slide::integer else 1 end;
+    end if;
+end
+$$;
+alter table chunks drop constraint if exists chunks_page_positive;
+alter table chunks add constraint chunks_page_positive check (page_or_slide >= 1);
