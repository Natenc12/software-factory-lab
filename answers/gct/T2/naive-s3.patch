@@ -72,6 +72,21 @@ def _json_safe(value: Any) -> Any:
     return value
 
 
+def _shorten(value: Any) -> Any:
+    """Decode client bytes and cut long client strings in a validation error list."""
+    if isinstance(value, bytes):
+        value = value.decode("utf-8", "replace")
+    if isinstance(value, str):
+        if len(value) > 512:
+            return value[:512] + f"...[truncated from {len(value)} chars]"
+        return value
+    if isinstance(value, dict):
+        return {_shorten(key): _shorten(item) for key, item in value.items()}
+    if isinstance(value, (list, tuple)):
+        return [_shorten(item) for item in value]
+    return value
+
+
 class _SafeJSONResponse(JSONResponse):
