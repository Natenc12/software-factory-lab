     return envelope(
-        422, KIND_VALIDATION, "request validation failed", jsonable_encoder(exc.errors())
+        422,
+        KIND_VALIDATION,
+        "request validation failed",
+        jsonable_encoder(_shorten(exc.errors())),
     )
 
 
