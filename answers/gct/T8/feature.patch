+
+
+@dataclass(frozen=True)
+class FileListing:
+    """One row of a class's file list: enough to render the status line for each upload."""
+
+    file_id: str
+    filename: str
+    status: str
+    failed_reason: str | None
+    created_at: datetime
+
+
+def list_class_files(
+    conn: psycopg.Connection,
+    *,
+    class_id: str,
+    owner_id: str,
+    limit: int = 50,
+    offset: int = 0,
+    status: str | None = None,
+) -> list[FileListing] | None:
+    """The files uploaded to `class_id`, newest first, or `None` if the owner has no such class.
+
+    `None` covers a missing class and another owner's class alike, as `class_exists` does (F12).
+    `status`, when given, keeps only files in that status. Ties on `created_at` (one transaction
+    enqueuing several files) are broken by `file_id` so pages never overlap.
+    """
+    canonical = canonical_uuid(
+        class_id,
+        fn="list_class_files",
+        param="class_id",
+        remedy="Use the class_id returned when the class was created.",
+    )
+    if not class_exists(conn, class_id=canonical, owner_id=owner_id):
+        return None
+    status_filter = "and f.status = %(status)s::file_status" if status is not None else ""
+    rows = conn.execute(
+        f"""
+        select f.file_id::text, f.filename, f.status, f.failed_reason, f.created_at
+        from files f
+        where f.class_id = %(class_id)s::uuid
+          and f.owner_id = %(owner_id)s
+          {status_filter}
+        order by f.created_at desc, f.file_id
+        limit %(limit)s offset %(offset)s
+        """,
+        {
+            "class_id": canonical,
+            "owner_id": owner_id,
+            "status": status,
+            "limit": limit,
+            "offset": offset,
+        },
+    ).fetchall()
+    return [FileListing(*row) for row in rows]
diff --git a/tests/gct/test_list_class_files.py b/tests/gct/test_list_class_files.py
new file mode 100644
index 0000000..1f9ba60
--- /dev/null
+++ b/tests/gct/test_list_class_files.py
@@ -0,0 +1,54 @@
+"""`list_class_files`: the uploads in one class, newest first, scoped to the owner."""
+
+from __future__ import annotations
+
+import uuid
+
+import pytest
+
+from gct.files import list_class_files
+from gct.jobs.queue import enqueue
+
+
+def _upload(conn, owner_id, class_id, tmp_path, name):
+    path = tmp_path / name
+    path.write_bytes(b"%PDF-1.7 placeholder")
+    return enqueue(conn, path=str(path), owner_id=owner_id, class_id=class_id)
+
+
+def test_lists_the_class_files_newest_first(db, tmp_path):
+    conn, owner_id, class_id = db
+    conn.autocommit = True
+    first = _upload(conn, owner_id, class_id, tmp_path, "week-1.pdf")
+    second = _upload(conn, owner_id, class_id, tmp_path, "week-2.pdf")
+
+    files = list_class_files(conn, class_id=class_id, owner_id=owner_id)
+
+    assert [f.file_id for f in files] == [second, first]
+    assert [f.filename for f in files] == ["week-2.pdf", "week-1.pdf"]
+    assert all(f.status == "queued" and f.failed_reason is None for f in files)
+
+
+def test_limit_and_offset_page_through_without_overlap(db, tmp_path):
+    conn, owner_id, class_id = db
+    conn.autocommit = True
+    ids = [_upload(conn, owner_id, class_id, tmp_path, f"f{i}.pdf") for i in range(5)]
+
+    first = list_class_files(conn, class_id=class_id, owner_id=owner_id, limit=2, offset=0)
+    rest = list_class_files(conn, class_id=class_id, owner_id=owner_id, limit=10, offset=2)
+
+    assert len(first) == 2
+    assert {f.file_id for f in first} | {f.file_id for f in rest} == set(ids)
+    assert not {f.file_id for f in first} & {f.file_id for f in rest}
+
+
+def test_another_owners_class_is_none(db):
+    conn, _, class_id = db
+    assert list_class_files(conn, class_id=class_id, owner_id="someone-else") is None
+    assert list_class_files(conn, class_id=str(uuid.uuid4()), owner_id="someone-else") is None
+
+
+def test_a_malformed_class_id_is_refused(db):
+    conn, owner_id, _ = db
+    with pytest.raises(ValueError):
+        list_class_files(conn, class_id="biology", owner_id=owner_id)
