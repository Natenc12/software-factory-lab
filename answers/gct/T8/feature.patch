+
+
+class ClassFiles(BaseModel):
+    files: list[FileListItem]
+    page: int
+    per_page: int
+
+
+@router.get("/{class_id}/files")
+def class_files(
+    conn: Conn,
+    owner: OwnerId,
+    class_id: str,
+    page: Annotated[int, Query(ge=1)] = 1,
+    per_page: Annotated[int, Query(ge=1, le=100)] = 20,
+    status: Literal["queued", "processing", "ready", "failed"] | None = None,
+) -> ClassFiles:
+    """The class's uploads, newest first, a page at a time, each with its status sentence.
+
+    404 `class_not_found` for a missing class and for another owner's class alike (F12).
+    """
+    try:
+        files = list_class_files(
+            conn,
+            class_id=class_id,
+            owner_id=owner,
+            limit=per_page,
+            offset=page * per_page,
+            status=status,
+        )
+    except ValueError as exc:
+        raise ApiError(
+            400,
+            "bad_class_id",
+            "class_id must be a uuid. Use the id returned when the class was created.",
+        ) from exc
+    if not files:
+        raise ApiError(
+            404,
+            "class_not_found",
+            "No such class. Check the class id, or create the class first.",
+        )
+    items = []
+    for f in files:
+        if f.status == "failed":
+            message = _FAILED_MESSAGE.get(f.failed_reason, _UNKNOWN_FAILURE)
+        else:
+            message = _STATUS_MESSAGE[f.status]
+        items.append(
+            FileListItem(
+                file_id=f.file_id,
+                filename=f.filename,
+                status=f.status,
+                failed_reason=f.failed_reason,
+                message=message,
+                created_at=f.created_at.isoformat(),
+            )
+        )
+    return ClassFiles(files=items, page=page, per_page=per_page)
