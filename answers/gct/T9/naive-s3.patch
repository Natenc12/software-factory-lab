+@router.put("/{file_id}", status_code=202)
+def replace(
+    conn: Conn,
+    owner: OwnerId,
+    file_id: str,
+    file: Annotated[UploadFile, File()],
+) -> UploadAccepted:
+    """Upload new contents for an existing file; 202, and the client polls `GET /files/{file_id}`.
+
+    404 `file_not_found` for a missing file and for another owner's alike; 409 `file_busy` while
+    the file is queued or processing or a replacement is already pending. Both are checked before
+    anything is staged, and again under a row lock when the replacement is queued.
+    """
+    busy = ApiError(
+        409,
+        "file_busy",
+        "This file is still being processed, or a replacement is already on its way. Try again "
+        "once it is ready or failed.",
+    )
+    try:
+        uuid.UUID(file_id)
+    except ValueError as exc:
+        raise ApiError(
+            400,
+            "bad_file_id",
+            "file_id must be a uuid. Use the file_id returned when the file was uploaded.",
+        ) from exc
+    try:
+        staged = stage(file.file, filename=file.filename)
+    except StagingError as exc:
+        raise ApiError(_STAGING_STATUS[exc.reason], exc.reason, str(exc)) from exc
+    try:
+        found = replace_file(conn, file_id=file_id, owner_id=owner, path=staged)
+    except FileBusy as exc:
+        raise busy from exc
+    if not found:
+        raise ApiError(
+            404,
+            "file_not_found",
+            "No such file. Check the file id returned when the file was uploaded.",
+        )
+    return UploadAccepted(file_id=str(uuid.UUID(file_id)), filename=Path(staged).name)
+
+
+class FileVersionOut(BaseModel):
+    version: int
+    filename: str
+    outcome: str
+    failed_reason: str | None
+    current: bool
+
+
+class FileVersions(BaseModel):
+    versions: list[FileVersionOut]
+
+
+@router.get("/{file_id}/versions")
+def file_versions(conn: Conn, owner: OwnerId, file_id: str) -> FileVersions:
+    """Every version of the file, newest first; 404 and 400 exactly as `GET /files/{file_id}`."""
+    try:
+        versions = list_versions(conn, file_id=file_id, owner_id=owner)
+    except ValueError as exc:
+        raise ApiError(
+            400,
+            "bad_file_id",
+            "file_id must be a uuid. Use the file_id returned when the file was uploaded.",
+        ) from exc
+    if versions is None:
+        raise ApiError(
+            404,
+            "file_not_found",
+            "No such file. Check the file id returned when the file was uploaded.",
+        )
+    return FileVersions(
+        versions=[
+            FileVersionOut(
+                version=v.version,
+                filename=v.filename,
+                outcome=v.outcome,
+                failed_reason=v.failed_reason,
+                current=v.current,
+            )
+            for v in versions
+        ]
     )
