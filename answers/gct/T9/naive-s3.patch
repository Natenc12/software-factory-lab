 @router.get("/{file_id}")
@@ -291,4 +293,50 @@ def file_status(conn: Conn, owner: OwnerId, file_id: str) -> FileStatusResponse:
         status=result.status,
         failed_reason=result.failed_reason,
         message=message,
+        replacement=result.replacement,
+        replacement_failed_reason=result.replacement_failed_reason,
     )
