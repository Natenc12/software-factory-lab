@@ -106,4 +113,78 @@ def get_file_status(conn: psycopg.Connection, *, file_id: str, owner_id: str) ->
     ).fetchone()
     if row is None:
         return None
-    return FileStatus(status=row[0], failed_reason=row[1], filename=row[2])
+    status, failed_reason, filename, pending, replacement_failed_reason = row
+    replacement = None
+    if status == "ready" and pending:
+        replacement = "pending"
+    elif status == "ready" and replacement_failed_reason:
