diff --git a/tests/gct/test_replace_file.py b/tests/gct/test_replace_file.py
new file mode 100644
index 0000000..7d818a3
--- /dev/null
+++ b/tests/gct/test_replace_file.py
@@ -0,0 +1,75 @@
+"""`replace_file`: new contents for an existing file, published only when the worker succeeds."""
+
+from __future__ import annotations
+
+import io
+from pathlib import Path
+
+import pytest
+from reportlab.pdfgen import canvas
+
+from gct.config import EMBEDDING_DIM
+from gct.files import FileBusy, get_file_status, replace_file
+from gct.ingest.chunk import CHUNK_OVERLAP_WORDS, CHUNK_SIZE_WORDS
+from gct.jobs.queue import enqueue
+from gct.jobs.worker import process_one
+
+
+class FakeEmbeddings:
+    model_id = "fake-embed-3"
+
+    def embed(self, texts):
+        return [[1.0] + [0.0] * (EMBEDDING_DIM - 1) for _ in texts]
+
+
+def _pdf(path: Path, text: str) -> Path:
+    buf = io.BytesIO()
+    c = canvas.Canvas(buf, pagesize=(612, 792))
+    c.drawString(72, 700, text)
+    c.showPage()
+    c.save()
+    path.write_bytes(buf.getvalue())
+    return path
+
+
+def _tick(conn) -> bool:
+    return process_one(
+        conn,
+        embedder=FakeEmbeddings(),
+        chunk_size=CHUNK_SIZE_WORDS,
+        chunk_overlap=CHUNK_OVERLAP_WORDS,
+    )
+
+
+def test_a_ready_file_stays_ready_while_its_replacement_is_pending(worker_db, tmp_path):
+    conn, owner_id, class_id = worker_db
+    conn.autocommit = True
+    file_id = enqueue(
+        conn, path=_pdf(tmp_path / "a.pdf", "one"), owner_id=owner_id, class_id=class_id
+    )
+    assert _tick(conn)
+
+    assert replace_file(
+        conn, file_id=file_id, owner_id=owner_id, path=_pdf(tmp_path / "b.pdf", "two")
+    )
+    status = get_file_status(conn, file_id=file_id, owner_id=owner_id)
+    assert (status.status, status.replacement, status.filename) == ("ready", "pending", "a.pdf")
+
+    with pytest.raises(FileBusy):
+        replace_file(conn, file_id=file_id, owner_id=owner_id, path=tmp_path / "b.pdf")
+
+    assert _tick(conn)
+    status = get_file_status(conn, file_id=file_id, owner_id=owner_id)
+    assert (status.status, status.replacement, status.filename) == ("ready", None, "b.pdf")
+
+
+def test_another_owners_file_is_not_replaced(db, tmp_path):
+    conn, owner_id, class_id = db
+    conn.autocommit = True
+    file_id = enqueue(
+        conn, path=_pdf(tmp_path / "a.pdf", "one"), owner_id=owner_id, class_id=class_id
+    )
+    assert (
+        replace_file(conn, file_id=file_id, owner_id="someone-else", path=tmp_path / "a.pdf")
+        is False
+    )
