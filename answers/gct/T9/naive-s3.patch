+class FileBusy(Exception):
+    """The file cannot be replaced now: it is queued or processing, or a replacement is pending."""
+
+
+def replace_file(
+    conn: psycopg.Connection, *, file_id: str, owner_id: str, path: str | Path
+) -> bool:
+    """Queue `path` (already staged) as the new contents of `file_id`. False if no such file.
+
+    A `ready` file stays `ready`, answering from its current chunks, until the worker publishes the
+    new version; if that fails the file keeps its content and records `replacement_failed_reason`.
+    A `failed` file goes back to `queued` and is processed like a new upload. Anything else, or a
+    file with a replacement already pending, raises `FileBusy` and changes nothing.
+    """
+    canonical = canonical_uuid(
+        file_id,
+        fn="replace_file",
+        param="file_id",
+        remedy="Pass the file_id returned when the file was uploaded.",
+    )
+    require_idle(conn, "replace_file")
+    with conn.transaction():
+        row = conn.execute(
+            """
+            select f.status, f.pending_staging_ref, f.class_id::text,
+                   exists (
+                       select 1 from jobs j
+                       where j.file_id = f.file_id and j.state in ('queued', 'processing')
+                   )
+            from files f
+            where f.file_id = %(file_id)s::uuid and f.owner_id = %(owner_id)s
+            for update of f
+            """,
+            {"file_id": canonical, "owner_id": owner_id},
+        ).fetchone()
+        if row is None:
+            return False
+        status, pending, class_id, job_active = row
+        if status not in ("ready", "failed") or pending is not None or job_active:
+            raise FileBusy(f"file {canonical} is {status} or already being replaced")
+        conn.execute(
+            """
+            update files
+            set pending_staging_ref = %(path)s,
+                replacement_failed_reason = null,
+                status = case when status = 'failed' then 'queued' else status end,
+                failed_reason = case when status = 'failed' then null else failed_reason end,
+                updated_at = now()
+            where file_id = %(file_id)s::uuid
+            """,
+            {"path": str(Path(path).resolve()), "file_id": canonical},
+        )
+        conn.execute(
+            """
+            insert into jobs (file_id, owner_id, class_id)
+            values (%(file_id)s::uuid, %(owner_id)s, %(class_id)s::uuid)
+            """,
+            {"file_id": canonical, "owner_id": owner_id, "class_id": class_id},
+        )
+        conn.execute(
+            """
+            insert into file_versions (file_id, version, filename, staging_ref)
+            select %(file_id)s::uuid, coalesce(max(version), 0) + 1, %(filename)s, %(path)s
+            from file_versions where file_id = %(file_id)s::uuid
+            """,
+            {"file_id": canonical, "filename": Path(path).name, "path": str(Path(path).resolve())},
+        )
+    return True
+
+
+@dataclass(frozen=True)
+class FileVersion:
+    version: int
+    filename: str
+    outcome: str  # pending, published or failed
+    failed_reason: str | None
+    current: bool  # the version the file's chunks come from now
+
+
+def list_versions(
+    conn: psycopg.Connection, *, file_id: str, owner_id: str
+) -> list[FileVersion] | None:
+    """Every version of `file_id`, newest first, or None if the owner has no such file."""
+    canonical = canonical_uuid(
+        file_id,
+        fn="list_versions",
+        param="file_id",
+        remedy="Pass the file_id returned when the file was uploaded.",
+    )
+    owned = conn.execute(
+        "select 1 from files where file_id = %(file_id)s::uuid and owner_id = %(owner_id)s",
+        {"file_id": canonical, "owner_id": owner_id},
+    ).fetchone()
+    if owned is None:
+        return None
+    rows = conn.execute(
+        """
+        select version, filename, outcome, failed_reason,
+               coalesce(version = max(version) filter (where outcome = 'published') over (), false)
+        from file_versions where file_id = %(file_id)s::uuid
+        order by version desc
+        """,
+        {"file_id": canonical},
+    ).fetchall()
+    return [
+        FileVersion(version=v, filename=n, outcome=o, failed_reason=r, current=bool(c))
+        for v, n, o, r, c in rows
+    ]
