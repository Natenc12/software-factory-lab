new file mode 100644
index 0000000..66c221a
--- /dev/null
+++ b/migrations/0005_file_replacement.sql
@@ -0,0 +1,43 @@
+-- 0005: replacing an uploaded file's contents (PUT /files/{file_id}).
+--
+-- `pending_staging_ref` points at the staged bytes of a replacement that has not been published yet;
+-- `staging_ref` keeps pointing at the bytes the file's current chunks came from until it is. When a
+-- replacement of a `ready` file fails, the file keeps its content and `replacement_failed_reason`
+-- says why (the same closed set as `failed_reason`). Both columns are NULL for every existing row.
+-- Re-runnable: scripts/migrate.py applies every file on every run.
+
+alter table files add column if not exists pending_staging_ref text;
+alter table files add column if not exists replacement_failed_reason text;
+
+alter table files drop constraint if exists files_replacement_failed_reason_check;
+alter table files add constraint files_replacement_failed_reason_check
+    check (replacement_failed_reason in
+        ('unparseable','protected','unsupported','empty','too_long','transient_exhausted'));
+
+-- Every upload of a file, first upload and replacements alike, is a numbered version: 1, 2, 3 ... per
+-- file, in upload order, with no gaps (failed versions keep their number). `outcome` is `pending`
+-- until the worker publishes the version or gives up on it.
+create table if not exists file_versions (
+    file_id        uuid not null references files(file_id) on delete cascade,
+    version        int  not null check (version >= 1),
+    filename       text not null,
+    staging_ref    text,
+    outcome        text not null default 'pending'
+                       check (outcome in ('pending','published','failed')),
+    failed_reason  text
+                       check (failed_reason in
+                           ('unparseable','protected','unsupported','empty','too_long','transient_exhausted')),
+    created_at     timestamptz not null default now(),
+    settled_at     timestamptz,
+    primary key (file_id, version)
+);
+
+-- Files that existed before versions did are version 1, with the outcome their status implies.
+insert into file_versions (file_id, version, filename, staging_ref, outcome, failed_reason, created_at, settled_at)
+select f.file_id, 1, f.filename, f.staging_ref,
+       case f.status when 'ready' then 'published' when 'failed' then 'failed' else 'pending' end,
+       case when f.status = 'failed' then f.failed_reason end,
+       f.created_at,
+       case when f.status in ('ready', 'failed') then f.updated_at end
+from files f
+where not exists (select 1 from file_versions v where v.file_id = f.file_id);
