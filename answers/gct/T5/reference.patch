+class ClassNameTaken(ValueError):
+    """`create_class` was asked for a name this owner already uses.
+
+    Not a `ClassNameError`: that set is closed and describes names no class may have. This one
+    is about the owner's other classes, and an adapter answers it differently (409, not 400).
+    """
+
+    def __init__(self, name: str) -> None:
+        super().__init__(
+            f"this owner already has a class named {name!r} - pick a different name, or use the "
+            "existing class"
+        )
+        self.name = name
+
+
+def name_key(name: str) -> str:
+    """What two class names are compared on: case-insensitive, whitespace trimmed and collapsed.
+
+    `"Biology 101"`, `" biology  101 "` and `"BIOLOGY\t101"` share a key; `"Biology-101"` does
+    not. The stored name is still exactly what was typed - this is only the comparison.
+    """
+    return " ".join(name.split()).casefold()
+
