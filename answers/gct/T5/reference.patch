diff --git a/tests/gct/test_class_name_taken.py b/tests/gct/test_class_name_taken.py
new file mode 100644
index 0000000..1c0ae8b
--- /dev/null
+++ b/tests/gct/test_class_name_taken.py
@@ -0,0 +1,38 @@
+"""One owner cannot have two classes with the same name (case and spacing ignored)."""
+
+from __future__ import annotations
+
+import pytest
+
+from gct.classes import ClassNameTaken, create_class, name_key
+
+
+@pytest.mark.parametrize(
+    "variant", ["Biology 101", "biology 101", " Biology   101 ", "BIOLOGY\t101"]
+)
+def test_a_name_differing_only_in_case_or_spacing_is_taken(db, variant):
+    conn, owner_id, _ = db
+    conn.autocommit = True
+    create_class(conn, owner_id=owner_id, name="Biology 101")
+    with pytest.raises(ClassNameTaken):
+        create_class(conn, owner_id=owner_id, name=variant)
+
+
+def test_other_names_and_other_owners_are_free(db, db_other):
+    conn, owner_id, _ = db
+    conn.autocommit = True
+    create_class(conn, owner_id=owner_id, name="Biology 101")
+    create_class(conn, owner_id=owner_id, name="Biology-101")
+    create_class(conn, owner_id=f"{owner_id}-other", name="biology 101")
+    try:
+        names = db_other.execute(
+            "select name from classes where owner_id = %s order by name", (owner_id,)
+        ).fetchall()
+        assert names == [("Biology 101",), ("Biology-101",), ("test class",)]
+    finally:
+        conn.execute("delete from classes where owner_id = %s", (f"{owner_id}-other",))
+
+
+def test_name_key():
+    assert name_key("  Biology \n 101 ") == name_key("biology 101")
+    assert name_key("Biology-101") != name_key("Biology 101")
