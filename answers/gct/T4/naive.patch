 import psycopg
 
+from gct.db import require_idle
 from gct.ids import canonical_uuid
 
 
@@ -107,3 +108,52 @@ def get_file_status(conn: psycopg.Connection, *, file_id: str, owner_id: str) ->
     if row is None:
         return None
     return FileStatus(status=row[0], failed_reason=row[1], filename=row[2])
+
+
+class FileBusy(Exception):
+    """The worker is processing this file right now, so it cannot be deleted yet."""
+
+
+def delete_file(conn: psycopg.Connection, *, file_id: str, owner_id: str) -> bool:
+    """Delete `file_id` for `owner_id`: its chunks, its job, its `files` row and its staged bytes.
+
+    Returns `False`, and deletes nothing, when there is no such file for this owner - a missing
+    file and another owner's file look the same, as in `get_file_status` (F12).
+
+    Raises `FileBusy` while the worker is on the file. Two rows say so and either is enough: the
+    job is `processing` from the moment `claim` commits, and the file turns `processing` one
+    statement later. Deleting in that window would pull the job out from under the worker, and its
+    publish would then recreate the `files` row with no job behind it.
+
+    The rows go in one transaction; the `files` row is locked first so a claim cannot slip in
+    between the check and the delete. The staged bytes are removed only after that commits, and a
+    file that is already gone from staging is not an error.
+    """
+    canonical = canonical_uuid(
+        file_id,
+        fn="delete_file",
+        param="file_id",
+        remedy="Pass the file_id returned when the file was uploaded.",
+    )
+    require_idle(conn, "delete_file")
+    with conn.transaction():
+        row = conn.execute(
+            """
+            select f.status, f.staging_ref, false
+            from files f
+            where f.file_id = %(file_id)s::uuid and f.owner_id = %(owner_id)s
+            for update of f
+            """,
+            {"file_id": canonical, "owner_id": owner_id},
+        ).fetchone()
+        if row is None:
+            return False
+        status, staging_ref, job_running = row
+        if status == "processing" or job_running:
+            raise FileBusy(f"file {canonical} is being processed; delete it once it is done")
+        for table in ("chunks", "jobs", "files"):
+            conn.execute(
+                f"delete from {table} where file_id = %(file_id)s::uuid",
+                {"file_id": canonical},
+            )
+    return True
