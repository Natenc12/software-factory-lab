+def unstage(staging_ref: str | Path | None) -> None:
+    """Remove a staged upload: the file, and its slot directory if that is now empty.
+
+    Missing is fine - the bytes may never have arrived, or a previous delete removed them.
+    """
+    if not staging_ref:
+        return
+    path = Path(staging_ref)
+    path.unlink(missing_ok=True)
+    slot = path.parent
+    try:
+        slot.rmdir()
+    except OSError:
+        pass  # not empty, already gone, or not a slot: leave it
+
