index 0000000..cf1ee5e
--- /dev/null
+++ b/tests/gct/api/test_delete_route.py
@@ -0,0 +1,29 @@
+"""`DELETE /files/{file_id}` over the real app; the library half is in test_delete_file.py."""
+
+from __future__ import annotations
+
+import io
+
+from gct.db import connect
+from gct.jobs.queue import enqueue
+from gct.staging import stage
+
+
+def test_delete_answers_204_then_404(api, tmp_path):
+    staged = stage(io.BytesIO(b"bytes"), filename="lecture.pdf", staging_dir=tmp_path)
+    with connect() as conn:
+        conn.autocommit = True
+        file_id = enqueue(conn, path=staged, owner_id=api.owner_id, class_id=api.class_id)
+
+    first = api.client.delete(f"/files/{file_id}")
+    assert first.status_code == 204
+    assert first.content == b""
+    second = api.client.delete(f"/files/{file_id}")
+    assert second.status_code == 404
+    assert second.json()["error"]["kind"] == "file_not_found"
+
+
+def test_delete_refuses_a_malformed_id(api):
+    response = api.client.delete("/files/not-a-uuid")
+    assert response.status_code == 400
+    assert response.json()["error"]["kind"] == "bad_file_id"
diff --git a/tests/gct/test_delete_file.py b/tests/gct/test_delete_file.py
new file mode 100644
index 0000000..249a02e
--- /dev/null
+++ b/tests/gct/test_delete_file.py
@@ -0,0 +1,58 @@
+"""`delete_file` and `DELETE /files/{file_id}`: what goes, what stays, and when it is refused."""
+
+from __future__ import annotations
+
+import io
+from pathlib import Path
+
+import pytest
+
+from gct.files import FileBusy, delete_file, get_file_status
+from gct.jobs.queue import enqueue
+from gct.staging import stage
+
+
+def _queued(conn, owner_id, class_id, tmp_path, name="lecture.pdf") -> tuple[str, Path]:
+    staged = Path(stage(io.BytesIO(b"bytes"), filename=name, staging_dir=tmp_path))
+    return enqueue(conn, path=str(staged), owner_id=owner_id, class_id=class_id), staged
+
+
+def test_delete_removes_the_row_the_job_and_the_staged_bytes(db, db_other, tmp_path):
+    conn, owner_id, class_id = db
+    conn.autocommit = True
+    file_id, staged = _queued(conn, owner_id, class_id, tmp_path)
+
+    assert delete_file(conn, file_id=file_id, owner_id=owner_id) is True
+
+    assert get_file_status(db_other, file_id=file_id, owner_id=owner_id) is None
+    assert db_other.execute(
+        "select count(*) from jobs where file_id = %s::uuid", (file_id,)
+    ).fetchone() == (0,)
+
+
+def test_another_owners_file_is_reported_missing_and_kept(db, db_other, tmp_path):
+    conn, owner_id, class_id = db
+    conn.autocommit = True
+    file_id, staged = _queued(conn, owner_id, class_id, tmp_path)
+
+    assert delete_file(conn, file_id=file_id, owner_id="another-owner") is False
+    assert get_file_status(db_other, file_id=file_id, owner_id=owner_id) is not None
+    assert staged.exists()
+
+
+@pytest.mark.parametrize(
+    "busy_sql",
+    [
+        "update files set status = 'processing' where file_id = %s::uuid",
+    ],
+)
+def test_a_file_being_processed_is_refused(db, db_other, tmp_path, busy_sql):
+    conn, owner_id, class_id = db
+    conn.autocommit = True
+    file_id, staged = _queued(conn, owner_id, class_id, tmp_path)
+    conn.execute(busy_sql, (file_id,))
+
+    with pytest.raises(FileBusy):
+        delete_file(conn, file_id=file_id, owner_id=owner_id)
+    assert get_file_status(db_other, file_id=file_id, owner_id=owner_id) is not None
+    assert staged.exists()
