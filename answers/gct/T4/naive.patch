+@router.delete("/{file_id}", status_code=204)
+def remove_file(conn: Conn, owner: OwnerId, file_id: str) -> Response:
+    """Delete an uploaded file: its chunks, its job, its status row and its staged bytes.
+
+    404 for a missing file and for another owner's file alike, as `GET /files/{file_id}` does.
+    409 `file_busy` while the worker is processing it.
+    """
+    try:
+        deleted = delete_file(conn, file_id=file_id, owner_id=owner)
+    except FileBusy as exc:
+        raise ApiError(
+            409,
+            "file_busy",
+            "This file is being processed right now. Try again once it is ready or failed.",
+        ) from exc
+    except ValueError as exc:
+        raise ApiError(
+            400,
+            "bad_file_id",
+            "file_id must be a uuid. Use the file_id returned when the file was uploaded.",
+        ) from exc
+    if not deleted:
+        raise ApiError(
+            404,
+            "file_not_found",
+            "No such file. Check the file id returned when the file was uploaded.",
+        )
+    return Response(status_code=204)
