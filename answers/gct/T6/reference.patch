@@ -0,0 +1,8 @@
+-- 0005: `files.word_count` - how many words a refused-as-too-long file had.
+--
+-- Written only when a file is refused as `too_long` (ADR 0029), so `GET /files/{file_id}` can tell
+-- the student how far over the limit their upload was. NULL everywhere else, including every row
+-- that existed before this migration. Re-runnable: `scripts/migrate.py` applies every file on
+-- every run.
+
+alter table files add column if not exists word_count integer;
