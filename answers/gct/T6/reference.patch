diff --git a/tests/gct/ingest/test_too_long_word_count.py b/tests/gct/ingest/test_too_long_word_count.py
new file mode 100644
index 0000000..b72f454
--- /dev/null
+++ b/tests/gct/ingest/test_too_long_word_count.py
@@ -0,0 +1,49 @@
+"""A file refused as too long records its word count, and its status message says it."""
+
+from __future__ import annotations
+
+from pptx import Presentation
+from pptx.util import Inches
+
+from gct.config import MAX_INGEST_WORDS
+from gct.files import get_file_status
+from gct.ingest.chunk import CHUNK_OVERLAP_WORDS, CHUNK_SIZE_WORDS
+from gct.jobs.queue import enqueue
+from gct.jobs.worker import process_one
+
+
+class CountingEmbeddings:
+    model_id = "fake-embed-3"
+
+    def __init__(self) -> None:
+        self.calls = 0
+
+    def embed(self, texts):
+        self.calls += 1
+        return [[1.0] + [0.0] * 1535 for _ in texts]
+
+
+def _deck(path, words: int):
+    prs = Presentation()
+    slide = prs.slides.add_slide(prs.slide_layouts[6])
+    box = slide.shapes.add_textbox(Inches(1), Inches(1), Inches(5), Inches(1))
+    box.text_frame.text = " ".join(["w"] * words)
+    prs.save(path)
+    return path
+
+
+def test_a_too_long_file_records_its_word_count(worker_db, db_other, tmp_path):
+    conn, owner_id, class_id = worker_db
+    conn.autocommit = True
+    deck = _deck(tmp_path / "textbook.pptx", MAX_INGEST_WORDS + 1)
+    file_id = enqueue(conn, path=str(deck), owner_id=owner_id, class_id=class_id)
+    embedder = CountingEmbeddings()
+
+    assert process_one(
+        conn, embedder=embedder, chunk_size=CHUNK_SIZE_WORDS, chunk_overlap=CHUNK_OVERLAP_WORDS
+    )
+
+    status = get_file_status(db_other, file_id=file_id, owner_id=owner_id)
+    assert (status.status, status.failed_reason) == ("failed", "too_long")
+    assert status.word_count == MAX_INGEST_WORDS + 1
+    assert embedder.calls == 0
