+    def test_simplify_coalesce_null_arguments(self):
+        # Literal NULL arguments are dropped by default, without coalesce_simplification
+        for sql, expected in (
+            ("COALESCE(NULL, x)", "x"),
+            ("COALESCE(x, NULL)", "x"),
+            ("COALESCE(x, NULL, y)", "COALESCE(x, y)"),
+            ("COALESCE(NULL, NULL, x, NULL, y)", "COALESCE(x, y)"),
+            ("COALESCE(NULL, NULL)", "NULL"),
+            ("COALESCE(x, y)", "COALESCE(x, y)"),
+            ("COALESCE(CAST(NULL AS DATE), x)", "COALESCE(CAST(NULL AS DATE), x)"),
+        ):
+            for coalesce_simplification in (False, True):
+                with self.subTest(sql=sql, coalesce_simplification=coalesce_simplification):
+                    simplified = optimizer.simplify.simplify(
+                        parse_one(sql), coalesce_simplification=coalesce_simplification
+                    )
+                    self.assertEqual(simplified.sql(), expected)
+
+        self.assertEqual(
+            optimizer.optimize(
+                "SELECT COALESCE(NULL, a, NULL, b) AS c FROM t",
+                schema={"t": {"a": "INT", "b": "INT"}},
+            ).sql(),
+            'SELECT COALESCE("t"."a", "t"."b") AS "c" FROM "t" AS "t"',
+        )
+
+        # COALESCE as a Spark partitioning hint is not a function call
+        hint = "SELECT /*+ COALESCE(3) */ * FROM t"
+        self.assertEqual(
+            optimizer.simplify.simplify(parse_one(hint, read="spark")).sql("spark"), hint
+        )
+
+        # Plain transpilation is unaffected
+        self.assertEqual(
+            parse_one("SELECT COALESCE(NULL, a, NULL, b)").sql(),
+            "SELECT COALESCE(NULL, a, NULL, b)",
+        )
+
