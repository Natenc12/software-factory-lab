+    @annotate_types_on_change
+    def remove_null_coalesce_args(self, expression: exp.Expr) -> exp.Expr:
+        """
+        Drops literal NULL arguments, which can never be the result of a COALESCE:
+
+            COALESCE(NULL, x, NULL, y) -> COALESCE(x, y)
+            COALESCE(x, NULL) -> x
+            COALESCE(NULL, NULL) -> NULL
+        """
+        if (
+            not isinstance(expression, exp.Coalesce)
+            # COALESCE is also used as a Spark partitioning hint
+            or isinstance(expression.parent, exp.Hint)
+        ):
+            return expression
+
+        args = [expression.this, *expression.expressions]
+        kept = []
+        for arg in args:
+            if isinstance(arg, exp.Null):
+                continue
+            kept.append(arg)
+            # Nothing after a non-NULL constant is ever reached
+            if _is_nonnull_constant(arg):
+                break
+
+        if len(kept) == len(args):
+            return expression
+        if not kept:
+            return exp.null()
+        if len(kept) == 1:
+            return kept[0]
+
+        expression.set("this", kept[0])
+        expression.set("expressions", kept[1:])
+        return expression
+
