@@ -833,6 +833,7 @@ class Simplifier:
             node = self.simplify_connectors(node, root)
             node = self.remove_complements(node, root)
 
+            node = self.simplify_coalesce_args(node)
             if coalesce_simplification:
                 node = self.simplify_coalesce(node)
             node.parent = parent
@@ -1415,6 +1416,29 @@ class Simplifier:
 
         return None
 
+    def simplify_coalesce_args(self, expression: exp.Expr) -> exp.Expr:
+        """COALESCE(NULL, x, NULL, 1, y) -> COALESCE(x, 1): a NULL is never picked, and nothing
+        after a non-NULL constant is ever reached."""
+        if not isinstance(expression, exp.Coalesce) or isinstance(expression.parent, exp.Hint):
+            return expression
+
+        args = [expression.this, *expression.expressions]
+        kept = []
+        for arg in args:
+            if isinstance(arg, exp.Null):
+                continue
+            kept.append(arg)
+            if _is_nonnull_constant(arg):
+                break
+
+        if len(kept) == len(args):
+            return expression
+        if not kept:
+            return exp.null()
+        if len(kept) == 1:
+            return kept[0]
+        return exp.Coalesce(this=kept[0], expressions=kept[1:])
+
     @annotate_types_on_change
     def simplify_coalesce(self, expression: exp.Expr) -> exp.Expr:
         # COALESCE(x) -> x
