+    def update_alternative_sql(self, expression: exp.Update) -> str:
+        alternative = expression.args.get("alternative")
+        if not alternative:
+            return ""
+
+        import sqlglot.dialects.dialect
+
+        if (
+            not self.SUPPORTS_UPDATE_ALTERNATIVE
