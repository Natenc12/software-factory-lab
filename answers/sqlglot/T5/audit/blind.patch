--- a/tests/dialects/test_sqlite.py
+++ b/tests/dialects/test_sqlite.py
@@ -1705,6 +1705,35 @@ class TestSQLite(Validator):
         self.validate_identity("INSERT OR REPLACE INTO foo (x, y) VALUES (1, 2)")
         self.validate_identity("INSERT OR ROLLBACK INTO foo (x, y) VALUES (1, 2)")
         self.validate_identity("INSERT INTO foo AS f (x, y) VALUES (1, 2)")
+
+        for action in ("ABORT", "FAIL", "IGNORE", "REPLACE", "ROLLBACK"):
+            with self.subTest(f"UPDATE OR {action}"):
+                self.validate_identity(f"UPDATE OR {action} t SET b = 'x' WHERE id = 1").assert_is(
+                    exp.Update
+                )
+        self.validate_identity(
+            "UPDATE OR REPLACE t AS u SET b = 'x' FROM s WHERE u.id = s.id RETURNING *"
+        )
+        self.validate_identity("update or ignore t set b = 'x'", "UPDATE OR IGNORE t SET b = 'x'")
+        self.validate_all(
+            "UPDATE OR IGNORE t SET b = 'x'",
+            write={
+                "": "UPDATE OR IGNORE t SET b = 'x'",
+                "sqlite": "UPDATE OR IGNORE t SET b = 'x'",
+            },
+        )
+        self.assertEqual(
