+class Interval:
+    """A calendar interval: whole months first, clamped to the last day of the month, then a duration.
 
+    Adding one month to Jan 31 gives Feb 28 (or 29). A date plus a sub-day duration becomes a datetime.
+    """
+
+    __slots__ = ("months", "duration")
+
+    def __init__(self, months: int = 0, duration: timedelta = timedelta()) -> None:
+        self.months = months
+        self.duration = duration
+
+    def __neg__(self) -> Interval:
+        return Interval(-self.months, -self.duration)
+
+    def __radd__(self, other: object) -> object:
+        if not isinstance(other, date):
+            return NotImplemented
+        if self.duration % timedelta(days=1) and not isinstance(other, datetime):
+            other = datetime.combine(other, time())
+        if self.months:
+            year, month = divmod(other.month - 1 + self.months, 12)
+            year += other.year
+            month += 1
+            other = other.replace(
+                year=year, month=month, day=min(other.day, calendar.monthrange(year, month)[1])
+            )
+        return other + self.duration
+
+    __add__ = __radd__
+
+    def __rsub__(self, other: object) -> object:
+        return (-self).__radd__(other)
+
