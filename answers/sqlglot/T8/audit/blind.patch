+class CalendarDelta:
+    """
+    A calendar interval: a whole number of months plus a fixed duration.
+
+    Adding it to a date moves the months first, clamping the day to the last day of the target
+    month (Jan 31 + 1 month is Feb 28 or 29), and then adds the duration. A duration that is not
+    a whole number of days turns a plain date into a datetime. A zero interval is falsy.
+    """
+
+    __slots__ = ("months", "duration")
+
+    def __init__(self, months: int = 0, duration: timedelta = timedelta(0)) -> None:
+        self.months = months
+        self.duration = duration
+
+    def __bool__(self) -> bool:
+        return bool(self.months or self.duration)
+
+    def __neg__(self) -> CalendarDelta:
+        return CalendarDelta(-self.months, -self.duration)
+
+    def __eq__(self, other: object) -> bool:
+        return (
+            isinstance(other, CalendarDelta)
+            and self.months == other.months
+            and self.duration == other.duration
+        )
+
+    def __hash__(self) -> int:
+        return hash((self.months, self.duration))
+
+    def __repr__(self) -> str:
+        return f"CalendarDelta(months={self.months}, duration={self.duration!r})"
+
+    def add_to(self, value: date) -> date:
+        if (self.duration.seconds or self.duration.microseconds) and not isinstance(
+            value, datetime
+        ):
+            value = datetime(value.year, value.month, value.day)
+
+        if self.months:
+            year, month = divmod(value.year * 12 + value.month - 1 + self.months, 12)
+            month += 1
+            if not date.min.year <= year <= date.max.year:
+                raise ValueError(f"year {year} is out of range")
+            value = value.replace(
+                year=year, month=month, day=min(value.day, monthrange(year, month)[1])
+            )
+
+        return value + self.duration
+
+    def __add__(self, other: object) -> date:
+        if isinstance(other, date):
+            return self.add_to(other)
+        return NotImplemented
+
+    def __radd__(self, other: object) -> date:
+        return self.__add__(other)
+
+    def __rsub__(self, other: object) -> date:
+        if isinstance(other, date):
+            return (-self).add_to(other)
+        return NotImplemented
+
+
