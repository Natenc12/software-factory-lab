diff --git a/sqlglot/generator.py b/sqlglot/generator.py
index 202fcc70e..e034cc586 100644
--- a/sqlglot/generator.py
+++ b/sqlglot/generator.py
@@ -3895,7 +3895,17 @@ class Generator:
         return f"ANY {this}"
 
     def exists_sql(self, expression: exp.Exists) -> str:
-        return f"EXISTS{self.wrap(expression)}"
+        predicate = expression.expression
+        if not predicate:
+            return f"EXISTS{self.wrap(expression)}"
+
+        # Spark's EXISTS(array, lambda)
+        if self.CAN_IMPLEMENT_ARRAY_ANY:
+            filtered = exp.ArrayFilter(this=expression.this, expression=predicate)
+            return self.sql(exp.paren(exp.ArraySize(this=filtered).neq(0)))
+
+        self.unsupported("EXISTS with a lambda predicate is unsupported")
+        return self.function_fallback_sql(expression)
 
     def case_sql(self, expression: exp.Case) -> str:
         this = self.sql(expression, "this")
diff --git a/sqlglot/generators/presto.py b/sqlglot/generators/presto.py
index d92499066..8a70ef788 100644
--- a/sqlglot/generators/presto.py
+++ b/sqlglot/generators/presto.py
@@ -521,6 +521,12 @@ class PrestoGenerator(generator.Generator):
             expression.set("expressions", None)
         return super().datatype_sql(expression)
 
+    def exists_sql(self, expression: exp.Exists) -> str:
+        if expression.expression:
+            return self.func("ANY_MATCH", expression.this, expression.expression)
+
+        return super().exists_sql(expression)
+
     def extract_sql(self, expression: exp.Extract) -> str:
         date_part = expression.name
 
