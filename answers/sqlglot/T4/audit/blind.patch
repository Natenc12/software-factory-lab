+    def test_exists_lambda(self):
+        import duckdb
+
+        import sqlglot
+
+        sql = "SELECT EXISTS(arr, x -> x > 2) FROM t"
+        duckdb_sql = "SELECT (ARRAY_LENGTH(LIST_FILTER(arr, LAMBDA x : x > 2)) <> 0) FROM t"
+
+        for read in ("spark", "databricks", "hive"):
+            with self.subTest(read=read):
+                expression = parse_one(sql, read=read)
+                for write in ("spark", "spark2", "databricks", "hive"):
+                    self.assertEqual(expression.sql(write), sql)
+                for write in ("presto", "trino"):
+                    self.assertEqual(
+                        expression.sql(write, unsupported_level=ErrorLevel.RAISE),
+                        "SELECT ANY_MATCH(arr, x -> x > 2) FROM t",
+                    )
+                self.assertEqual(
+                    expression.sql("duckdb", unsupported_level=ErrorLevel.RAISE), duckdb_sql
+                )
+                self.assertEqual(
+                    expression.sql("postgres", unsupported_level=ErrorLevel.RAISE),
+                    "SELECT (ARRAY_LENGTH(ARRAY(SELECT x FROM UNNEST(arr) AS _t0(x) WHERE x > 2), 1) <> 0) FROM t",
+                )
+                self.assertEqual(
+                    expression.sql("bigquery", unsupported_level=ErrorLevel.RAISE),
+                    "SELECT (ARRAY_LENGTH(ARRAY(SELECT x FROM UNNEST(arr) AS x WHERE x > 2)) <> 0) FROM t",
+                )
+                with self.assertRaises(UnsupportedError):
+                    expression.sql("mysql", unsupported_level=ErrorLevel.RAISE)
+
+        rows = duckdb.sql(
+            "WITH t(arr) AS (VALUES ([1, 2, 3]), ([1]), ([]::INT[]), (NULL::INT[])) " + duckdb_sql
+        ).fetchall()
+        self.assertEqual(rows, [(True,), (False,), (False,), (None,)])
+
+        subquery = "SELECT * FROM t WHERE EXISTS(SELECT 1 FROM u WHERE u.id = t.id)"
+        for write in ("duckdb", "postgres", "bigquery", "presto", "mysql", "spark"):
+            self.assertEqual(sqlglot.transpile(subquery, read="spark", write=write)[0], subquery)
+
