--- a/sqlglot/generator.py
+++ b/sqlglot/generator.py
@@ -3895,6 +3895,22 @@ class Generator:
         return f"ANY {this}"
 
     def exists_sql(self, expression: exp.Exists) -> str:
+        predicate = expression.expression
+        if predicate:
+            # Spark's higher-order EXISTS(array, lambda): true if any element meets the condition
+            import sqlglot.dialects.dialect
+
+            if self.dialect.__class__ == sqlglot.dialects.dialect.Dialect:
+                return self.function_fallback_sql(expression)
+
+            if self.CAN_IMPLEMENT_ARRAY_ANY:
+                # Unlike arrayany_sql, an empty array must give FALSE here, and a NULL array NULL
+                filtered = exp.ArrayFilter(this=expression.this, expression=predicate)
+                return self.sql(exp.paren(exp.ArraySize(this=filtered).neq(0)))
+
+            self.unsupported("EXISTS(array, lambda) is unsupported")
+            return self.function_fallback_sql(expression)
+
         return f"EXISTS{self.wrap(expression)}"
 
     def case_sql(self, expression: exp.Case) -> str:
