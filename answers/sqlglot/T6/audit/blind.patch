+        self.validate_identity("SELECT VECTOR_COSINE_SIMILARITY(a, b) FROM t").selects[0].assert_is(
+            exp.CosineSimilarity
+        )
+        self.validate_all(
+            "SELECT VECTOR_COSINE_SIMILARITY(a, b) FROM t",
+            read={
+                "duckdb": "SELECT LIST_COSINE_SIMILARITY(a, b) FROM t",
+                "": "SELECT COSINE_SIMILARITY(a, b) FROM t",
+            },
+            write={
+                "snowflake": "SELECT VECTOR_COSINE_SIMILARITY(a, b) FROM t",
+                "duckdb": "SELECT LIST_COSINE_SIMILARITY(a, b) FROM t",
