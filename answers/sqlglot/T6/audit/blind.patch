+def cosine_similarity_to_distance_sql(self: Generator, expression: exp.CosineSimilarity) -> str:
+    """Cosine similarity for dialects that only have a cosine distance: (1 - distance)."""
+    distance = exp.CosineDistance(this=expression.this, expression=expression.expression)
+    return self.sql(exp.paren(exp.Literal.number(1) - distance, copy=False))
+
+
