+    def _scan_unquoted_path(self, terminators: str, stage: bool) -> None:
+        """
+        Consumes the rest of an unquoted path, e.g. the `s/a--b` in `@s/a--b`, as a single VAR token,
+        so that sequences such as `--`, `//` or `/*` in it are not read as comment starts.
