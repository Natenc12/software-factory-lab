diff --git a/tests/dialects/test_snowflake.py b/tests/dialects/test_snowflake.py
index 8421336ad..7955e8f62 100644
--- a/tests/dialects/test_snowflake.py
+++ b/tests/dialects/test_snowflake.py
@@ -122,6 +122,40 @@ class TestSnowflake(Validator):
             },
         )
 
+    def test_unquoted_paths_with_comment_markers(self):
+        # Unquoted stage and file:// paths run up to whitespace or one of , ; ( ) ' ` ~ < > |
+        for sql, expected in (
+            ("select $1 from @s/a--b", "SELECT $1 FROM @s/a--b"),
+            ("select $1 from @s/a//b", "SELECT $1 FROM @s/a//b"),
+            ("select $1 from @s/a/*b", "SELECT $1 FROM @s/a/*b"),
+            ("copy into t from @s/a--b/c", "COPY INTO t FROM @s/a--b/c"),
+            ("put file:///tmp/a--b @s/p", "PUT 'file:///tmp/a--b' @s/p"),
+            ('PUT file:///dir/a"b.csv @stg', "PUT 'file:///dir/a\"b.csv' @stg"),
+            ("SELECT $1 FROM @s/a -- note", "SELECT $1 FROM @s/a /* note */"),
+        ):
+            with self.subTest(sql=sql):
+                self.assertEqual(self.parse_one(sql).sql("snowflake"), expected)
+
+        for sql in (
+            "LIST @s/a--b",
+            "LIST @~/a--b",
+            'LIST @"my stage"/a--b',
+            "SELECT $1 FROM @s/a/*b*/c",
+            "SELECT $1 FROM @%t/a--b",
+            "SELECT $1 FROM @db.sch.stg/a--b",
+            "SELECT * FROM @s/a--b (FILE_FORMAT => 'f')",
+            "SELECT * FROM (SELECT $1 FROM @s/a--b) AS x",
+            "SELECT * FROM @s/a--b, @t/c--d",
+            "SELECT $1 FROM '@s/a--b'",
+            "LIST @s/a /* keep */",
+            "SELECT $1 FROM @s/a /* keep */ WHERE 1 = 1",
+            "COPY INTO t FROM 's3://b/p'",
+        ):
+            with self.subTest(sql=sql):
+                self.validate_identity(sql)
+
+        self.assertNotEqual(self.parse_one("LIST @s/a--b"), self.parse_one("LIST @s/a--c"))
+
