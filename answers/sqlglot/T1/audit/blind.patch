+    def _parse_limit(
+        self,
+        this: exp.Expr | None = None,
+        top: bool = False,
+        skip_limit_token: bool = False,
+    ) -> exp.Expr | None:
+        # TOP is not reserved in Snowflake: it only starts a row limit when it is directly
+        # followed by a number (SELECT TOP 5 ...). Anywhere else it is an ordinary name.
+        if (
+            top
+            and not skip_limit_token
+            and self._curr
+            and self._curr.token_type == TokenType.TOP
+            and not (self._next and self._next.token_type == TokenType.NUMBER)
+        ):
+            return None
+
+        return super()._parse_limit(this=this, top=top, skip_limit_token=skip_limit_token)
+
