diff --git a/tests/dialects/test_oracle.py b/tests/dialects/test_oracle.py
index aecad6a25..83cfd5a5a 100644
--- a/tests/dialects/test_oracle.py
+++ b/tests/dialects/test_oracle.py
@@ -6,6 +6,12 @@ from sqlglot.optimizer.qualify import qualify
 class TestOracle(Validator):
     dialect = "oracle"
 
+    def test_top_is_an_ordinary_name(self):
+        # Oracle has no TOP clause
+        self.validate_identity("SELECT top FROM t").selects[0].assert_is(exp.Column)
+        self.validate_identity("SELECT top, x FROM t")
+        self.validate_identity("SELECT TOP(5), x FROM t").selects[0].assert_is(exp.Anonymous)
+
     def test_create_table_tablespace(self):
         sql = "CREATE TABLE t (id NUMBER) TABLESPACE ts"
         create = self.validate_identity(sql).assert_is(exp.Create)
