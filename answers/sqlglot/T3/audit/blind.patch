+    def test_optimize_correlated_in_outside_filters(self):
+        # A correlated IN / = ANY is FALSE when its subquery finds no rows; the LEFT JOIN rewrite
+        # would make it NULL, so it must only be unnested where that makes no difference
+        for subquery in (
+            "SELECT y.b FROM y WHERE y.c = x.b",
+            "SELECT y.b FROM y WHERE y.c = x.b + 2",
+            "SELECT NULLIF(y.b, y.b) FROM y WHERE y.c = x.b",
+        ):
+            for predicate in (f"x.a IN ({subquery})", f"x.a = ANY ({subquery})"):
+                for sql in (
+                    f"SELECT x.a, {predicate} AS r FROM x",
+                    f"SELECT x.a, NOT ({predicate}) AS r FROM x",
+                    f"SELECT x.a, ({predicate}) AND x.a > 1 AS r FROM x",
+                    f"SELECT x.a, ({predicate}) OR x.a > 1 AS r FROM x",
+                    f"SELECT x.a, COALESCE(({predicate}), TRUE) AS r FROM x",
+                    f"SELECT x.a FROM x WHERE NOT ({predicate})",
+                    f"SELECT x.a FROM x WHERE NOT (({predicate}) AND x.a > 0)",
+                    f"SELECT x.a FROM x WHERE ({predicate}) IS NULL",
+                    f"SELECT x.a FROM x WHERE COALESCE(({predicate}), TRUE)",
+                    f"SELECT x.a FROM x WHERE ({predicate}) = FALSE",
+                    f"SELECT x.a FROM x WHERE ({predicate}) AND x.a > 1",
+                    f"SELECT x.a FROM x WHERE ({predicate}) OR x.a > 1",
+                    f"SELECT x.a, x.b FROM x GROUP BY x.a, x.b HAVING ({predicate}) = FALSE",
+                    f"SELECT x.a FROM x QUALIFY ROW_NUMBER() OVER () > 0 AND ({predicate}) = FALSE",
+                    f"SELECT x.a FROM x JOIN z ON x.a = z.b AND ({predicate}) = FALSE",
+                    f"SELECT x.a FROM x ORDER BY ({predicate}), x.a",
+                ):
+                    with self.subTest(sql=sql):
+                        optimized = optimizer.optimize(sql, schema=self.schema, dialect="duckdb")
+                        expected = self.conn.execute(sql).fetchall()
+                        actual = self.conn.execute(optimized.sql("duckdb")).fetchall()
+                        if "ORDER BY" in sql:
+                            self.assertEqual(actual, expected)
+                        else:
+                            self.assertCountEqual(actual, expected)
+
+        # A plain filter is still unnested
+        for sql in (
+            "SELECT x.a FROM x WHERE x.a IN (SELECT y.b FROM y WHERE y.c = x.a)",
+            "SELECT x.a FROM x WHERE x.a IN (SELECT y.b FROM y WHERE y.c = x.a) AND x.a > 1",
+        ):
+            with self.subTest(sql=sql):
+                optimized = optimizer.optimize(sql, schema=self.schema, dialect="duckdb")
+                self.assertIsNone(optimized.find(exp.In))
+                self.assertCountEqual(
+                    self.conn.execute(optimized.sql("duckdb")).fetchall(),
+                    self.conn.execute(sql).fetchall(),
+                )
+
