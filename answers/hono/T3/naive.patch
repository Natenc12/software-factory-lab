+const callHandler = (ws: BunServerWebSocket<BunWebSocketData>, handler: () => unknown): void => {
+  try {
+    handler()
+  } catch (error) {
+    const onError = ws.data.events.onError
+    if (!onError) {
+      throw error
+    }
+    const event = new Event('error') as Event & { error: unknown }
+    event.error = error
+    onError(event, createWSContext(ws))
+  }
+}
