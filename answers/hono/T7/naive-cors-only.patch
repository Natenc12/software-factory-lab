diff --git a/src/utils/origin.test.ts b/src/utils/origin.test.ts
new file mode 100644
index 00000000..153ccf93
--- /dev/null
+++ b/src/utils/origin.test.ts
@@ -0,0 +1,26 @@
+import { originListMatcher, originMatcher } from './origin'
+
+describe('originMatcher', () => {
+  it('matches an exact origin only', () => {
+    const test = originMatcher('https://example.com')
+    expect(test('https://example.com')).toBe(true)
+    expect(test('https://app.example.com')).toBe(false)
+  })
+
+  it('matches a subdomain at any depth for a wildcard', () => {
+    const test = originMatcher('https://*.example.com')
+    expect(test('https://app.example.com')).toBe(true)
+    expect(test('https://a.b.example.com')).toBe(true)
+    expect(test('https://a..example.com')).toBe(false)
+    expect(test('https://example.com')).toBe(false)
+    expect(test('http://app.example.com')).toBe(false)
+    expect(test('https://app.example.com:8443')).toBe(false)
+  })
+
+  it('matches any entry of a list', () => {
+    const test = originListMatcher(['https://a.org', 'https://*.b.org'])
+    expect(test('https://a.org')).toBe(true)
+    expect(test('https://x.b.org')).toBe(true)
+    expect(test('https://x.a.org')).toBe(false)
+  })
+})
diff --git a/src/utils/origin.ts b/src/utils/origin.ts
new file mode 100644
index 00000000..97ef104a
--- /dev/null
+++ b/src/utils/origin.ts
@@ -0,0 +1,32 @@
+/**
+ * @module
+ * Origin matching shared by the CORS and CSRF middlewares.
+ */
+
+// `scheme://*.rest`: a pattern whose host starts with a `*` label
+const wildcardRe = /^([a-z][a-z0-9+.-]*:\/\/)\*\.(.+)$/i
+
+const escapeRe = (s: string) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')
+
+/**
+ * Turns one allowed origin into a test. `https://*.example.com` matches one or more DNS labels in
+ * place of `*` (each letters, digits and hyphens), so a subdomain at any depth, never the bare
+ * `https://example.com`, with the same scheme and port as the pattern. Any other string matches only
+ * itself.
+ */
+export const originMatcher = (allowed: string): ((origin: string) => boolean) => {
+  const m = wildcardRe.exec(allowed)
+  if (!m) {
+    return (origin) => origin === allowed
+  }
+  const re = new RegExp(`^${escapeRe(m[1])}(?:[A-Za-z0-9-]+\\.)+${escapeRe(m[2])}$`)
+  return (origin) => re.test(origin)
+}
+
+/**
+ * The test for a list of allowed origins: an origin is allowed if any entry matches it.
+ */
+export const originListMatcher = (allowed: string[]): ((origin: string) => boolean) => {
+  const tests = allowed.map(originMatcher)
+  return (origin) => tests.some((test) => test(origin))
+}
