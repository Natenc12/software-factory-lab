+
+describe('Serve Static Middleware with redirectPost', () => {
+  it('Should answer a POST with 303 to the same path and query', async () => {
+    const getContent = vi.fn(async (path: string) => `Hello in ${path}`)
+    const app = new Hono().use('/static/*', baseServeStatic({ getContent, redirectPost: true }))
+
+    const res = await app.request('/static/hello.html?a=1', { method: 'POST' })
+
+    expect(res.status).toBe(303)
+    expect(res.headers.get('Location')).toBe('/static/hello.html?a=1')
+    expect(getContent).not.toBeCalled()
+  })
+
+  it('Should still pass other methods to the next handler', async () => {
+    const getContent = vi.fn(async (path: string) => `Hello in ${path}`)
+    const app = new Hono().use('/static/*', baseServeStatic({ getContent, redirectPost: true }))
+    app.put('/static/hello.html', (c) => c.text('Handled downstream', 202))
+
+    const res = await app.request('/static/hello.html', { method: 'PUT' })
+
+    expect(res.status).toBe(202)
+    expect(getContent).not.toBeCalled()
+  })
+})
