+++ b/tests/test_answer_cache.py
@@ -0,0 +1,53 @@
+import pytest
+
+from lab import ask, classes, questions
+from lab.providers import FakeProvider
+
+
+@pytest.fixture(autouse=True)
+def clean_cache():
+    ask.clear_answer_cache()
+    yield
+    ask.clear_answer_cache()
+
+
+class Counting(FakeProvider):
+    def __init__(self):
+        self.calls = 0
+
+    def answer(self, question, material):
+        self.calls += 1
+        return super().answer(question, material)
+
+
+def test_same_text_same_class_calls_provider_once(conn, biology):
+    klass, ada, ben = biology
+    p = Counting()
+    q1 = questions.ask_question(conn, klass.id, ada.id, "What is DNA?")
+    q2 = questions.ask_question(conn, klass.id, ben.id, "What is DNA?")
+    assert ask.answer(conn, q1.id, p).body == ask.answer(conn, q2.id, p).body
+    assert p.calls == 1
+
+
+def test_cache_is_per_class(conn, biology):
+    klass, ada, _ = biology
+    cooking = classes.create_class(conn, "Cooking", "Energy for a long day comes from oats.")
+    cora = classes.enrol_student(conn, cooking.id, "Cora")
+    text = "Where does energy come from?"
+    assert (
+        "Mitochondria"
+        in ask.answer(conn, questions.ask_question(conn, klass.id, ada.id, text).id).body
+    )
+    assert (
+        "oats" in ask.answer(conn, questions.ask_question(conn, cooking.id, cora.id, text).id).body
+    )
+
+
+def test_clear_answer_cache(conn, biology):
+    klass, ada, _ = biology
+    p = Counting()
+    q = questions.ask_question(conn, klass.id, ada.id, "What is DNA?")
+    ask.answer(conn, q.id, p)
+    ask.clear_answer_cache()
+    ask.answer(conn, q.id, p)
+    assert p.calls == 2
