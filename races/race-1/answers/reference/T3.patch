diff --git a/migrations/0003_last_seen.sql b/migrations/0003_last_seen.sql
new file mode 100644
index 0000000..27afe37
--- /dev/null
+++ b/migrations/0003_last_seen.sql
@@ -0,0 +1,6 @@
+-- When each student last asked a question (the latest asked_at, hidden questions included).
+
+alter table students add column last_seen text;
+
+update students
+set last_seen = (select max(q.asked_at) from questions q where q.student_id = students.id);
