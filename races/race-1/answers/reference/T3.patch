diff --git a/tests/test_last_seen.py b/tests/test_last_seen.py
new file mode 100644
index 0000000..7b170cd
--- /dev/null
+++ b/tests/test_last_seen.py
@@ -0,0 +1,13 @@
+from lab import classes, questions
+
+
+def test_new_student_has_no_last_seen(conn, biology):
+    _, ada, _ = biology
+    assert ada.last_seen is None
+
+
+def test_last_seen_moves_forward_only(conn, biology):
+    klass, ada, _ = biology
+    questions.ask_question(conn, klass.id, ada.id, "One?", "2026-03-04T10:00:00")
+    questions.ask_question(conn, klass.id, ada.id, "Two?", "2026-02-01T10:00:00")
+    assert classes.get_student(conn, ada.id).last_seen == "2026-03-04T10:00:00"
